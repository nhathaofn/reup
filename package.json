{
  "name": "t-blao",
  "version": "0.1.26",
  "description": "T-blao - Trinh tai video/audio da nen tang",
  "main": "./out/main/index.js",
  "author": "nhathaofn",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nhathaofn/reup.git"
  },
  "homepage": "https://github.com/nhathaofn/releases",
  "bugs": {
    "url": "https://github.com/nhathaofn/releases/issues"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "check:architecture": "node scripts/check-architecture.mjs",
    "feature:create": "node scripts/create-feature.mjs",
    "verify": "npm run typecheck && npm run check:architecture && npm run build",
    "verify:package:win": "node scripts/check-package-runtime-assets.mjs dist/win-unpacked",
    "fonts:copy": "node scripts/copy-fonts.mjs",
    "package:win": "electron-vite build && electron-builder --win -p never",
    "package:mac": "electron-vite build && electron-builder --mac -p never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "js-yaml": "^4.3.1",
    "opentype.js": "^2.0.0",
    "tldts": "^7.4.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
